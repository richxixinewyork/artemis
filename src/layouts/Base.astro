---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { getPortrait } from '../lib/media';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Hide from search engines (e.g. 404). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Social sharing image, generated from the hero portrait
const portrait = getPortrait('hero');
const og = portrait
  ? await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', position: 'attention', format: 'jpg', quality: 82 })
  : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL(url('/'), Astro.site).href,
  jobTitle: 'Growth & Creator Partnerships',
  address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY' },
  sameAs: site.socials.filter((s) => s.url && !s.demo).map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f7f3ec" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={site.hero.portraitAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-dvh bg-ivory text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:text-ivory"
    >Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal — elements with [data-reveal] fade up once when in view.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
