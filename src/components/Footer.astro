---
import { site } from '../content/site';
import { url } from '../lib/url';
---

<footer class="footer">
  <div class="shell footer-inner">
    <a href={url('/')} class="brand"><span class="dot" aria-hidden="true"></span>{site.name}</a>
    <nav aria-label="Footer">
      <ul>
        <li><a href={url('/#work')}>Work</a></li>
        <li><a href={url('/case-studies/')}>Case Studies</a></li>
        <li><a href={url('/resume/')}>Resume</a></li>
        {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>Email</a></li>}
      </ul>
    </nav>
    <small>© {site.copyrightYear} {site.name} · {site.location}</small>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 0;
    background: #141210;
    color: var(--color-on-dark-mute);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent-light);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-size: 0.88rem;
  }
  ul a {
    color: var(--color-on-dark);
  }
  ul a:hover {
    color: var(--color-accent-light);
  }
  small {
    font-size: 0.82rem;
  }
  @media (max-width: 680px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
