---
import { statusLabel, type ProjectStatus } from '../content/projects';

interface Props {
  status: ProjectStatus;
}
const { status } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[0.66rem] tracking-[0.16em] uppercase',
    status === 'in-development' ? 'border-accent text-accent' : 'border-line text-ink-soft',
  ]}
>
  <span
    class:list={['size-1.5 rounded-full', status === 'completed' ? 'bg-ink-mute' : 'bg-accent', status !== 'completed' && 'animate-pulse motion-reduce:animate-none']}
    aria-hidden="true"
  ></span>
  {statusLabel[status]}
</span>
