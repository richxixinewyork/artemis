---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';
import { getLogo } from '../lib/media';

/**
 * Compact, neutral panel used in Selected Work when a project has no real
 * imagery yet. The logo is the subject; the panel only frames it.
 *
 *  - Logos on a white background sit directly on the white panel, so no box shows.
 *  - Logos with a colored background (Project.logoBackground) are shown as their
 *    own brand tile, slightly smaller so their solid area doesn't outweigh the rest.
 *  - Projects without a logo show a monogram.
 * Logos are scaled with object-fit: contain — never stretched, cropped or recolored.
 */
interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
const logo = getLogo(project.slug);
const bg = (project.logoBackground ?? '#ffffff').toLowerCase();
const isTile = !['#fff', '#ffffff', 'white', 'transparent'].includes(bg);
---

<div class:list={['brand-panel', className]}>
  {logo ? (
    <div class:list={['brand-logo cover-media', isTile ? 'is-tile' : 'is-mark']} data-logo-wrap>
      <Image
        src={logo}
        alt={`${project.org} logo`}
        width={Math.min(560, logo.width)}
        format="webp"
        loading="lazy"
        decoding="async"
        class="brand-img"
        onerror="this.closest('[data-logo-wrap]').setAttribute('data-logo-failed','')"
      />
      <span class="brand-fallback font-display italic" aria-hidden="true">{project.org.charAt(0)}</span>
    </div>
  ) : (
    <div class="brand-logo cover-media is-mark" aria-hidden="true">
      <span class="brand-monogram font-display italic">{project.org.charAt(0)}</span>
    </div>
  )}
</div>

<style>
  .brand-panel {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-line);
  }
  @media (min-width: 1024px) {
    .brand-panel {
      aspect-ratio: 1;
    }
  }

  /* The logo box: absolutely placed so its size never depends on the image */
  .brand-logo {
    position: absolute;
    display: grid;
    place-items: center;
    transition: transform 1.2s var(--ease-editorial);
  }
  .brand-logo.is-mark {
    inset: 18% 16%;
  }
  .brand-logo.is-tile {
    inset: 24% 22%;
  }
  .brand-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .is-tile .brand-img {
    filter: drop-shadow(0 18px 28px rgb(28 26 24 / 0.18));
  }

  .brand-monogram,
  .brand-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    max-height: 13rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 1;
    padding-bottom: 0.08em;
    color: var(--color-ink);
  }
  .brand-fallback {
    display: none;
  }
  [data-logo-failed] .brand-img {
    display: none;
  }
  [data-logo-failed] .brand-fallback {
    display: grid;
  }
</style>
