---
import { Picture } from 'astro:assets';
import { site, stats } from '../content/site';
import { getPortrait } from '../lib/media';
import { url } from '../lib/url';

const portrait = getPortrait('hero');
const { hero } = site;
const [first, ...rest] = site.name.split(' ');
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <!-- Specialties wrap only between items, never mid-phrase -->
      <p class="eyebrow intro-rise" style="--d:0">
        {hero.eyebrow.split(' · ').map((s, i, all) => <><span class="nowrap">{s}{i < all.length - 1 && ' ·'}</span>{' '}</>)}
      </p>
      <h1 id="hero-title" class="intro-rise" style="--d:1">{first} <span class="accent">{rest.join(' ')}</span></h1>
      <p class="role intro-rise" style="--d:2">{hero.role}</p>
      <p class="lead intro-rise" style="--d:3">{hero.intro}</p>
      <div class="hero-cta intro-rise" style="--d:4">
        {site.resume.pdf && (
          <a href={url(site.resume.pdf)} download type="application/pdf" class="btn btn-primary">Download Resume</a>
        )}
        <a href={url('/#work')} class="btn btn-ghost">View My Work</a>
      </div>
      <dl class="hero-meta intro-rise" style="--d:5">
        {hero.meta.map((m) => (
          <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
        ))}
      </dl>
    </div>

    <figure class="hero-photo intro-rise" style="--d:2">
      <div class="photo-frame">
        {portrait && (
          <Picture
            src={portrait}
            alt={hero.portraitAlt}
            widths={[300, 600, 900]}
            sizes="300px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
      <figcaption class="photo-badge">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
        {site.location}
      </figcaption>
    </figure>
  </div>
</section>

<section class="stats on-dark" aria-label="Selected results">
  <div class="shell">
    <dl class="stats-grid">
      {stats.map((s, i) => (
        <div class="stat" data-reveal style={`--d:${i}`}>
          <dt class="lbl">{s.label}<span class="src">{s.source}</span></dt>
          <dd class="num">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 90px;
    background: var(--dark-bg);
    color: #fff;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.9fr;
    gap: 50px;
    align-items: center;
  }
  .eyebrow {
    max-width: 560px;
    line-height: 1.9;
  }
  .nowrap {
    white-space: nowrap;
  }
  h1 {
    margin: 10px 0 6px;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    color: #fff;
  }
  h1 .accent {
    color: var(--color-accent-light);
  }
  .role {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.45rem);
    font-weight: 600;
    line-height: 1.65;
    color: #e4dfd7;
  }
  .lead {
    max-width: 540px;
    margin-top: 22px;
    font-size: 1.08rem;
    color: var(--color-on-dark);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 38px;
  }
  .hero-meta div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .hero-meta dd {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.35;
    color: #fff;
  }
  .hero-meta dt {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-on-dark-mute);
  }

  /* Portrait: the reference's 300×360 (5:6) frame */
  .hero-photo {
    position: relative;
    justify-self: center;
  }
  .photo-frame {
    width: 300px;
    height: 360px;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: #fff;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.8);
  }
  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .photo-badge {
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    border-radius: 50px;
    background: var(--color-accent);
    color: var(--color-ivory);
    box-shadow: 0 12px 24px -10px rgb(154 63 44 / 0.6);
  }

  .stats {
    padding: 60px 0;
    background: var(--color-ink);
    color: #fff;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 700;
    line-height: 1.65;
    color: var(--color-accent-light);
  }
  .lbl {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #e4dfd7;
  }
  .src {
    display: block;
    margin-top: 2px;
    font-size: 0.78rem;
    color: var(--color-on-dark-mute);
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      order: -1;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 34px;
    }
  }
  @media (max-width: 680px) {
    .hero {
      min-height: auto;
      padding-top: 104px;
      padding-bottom: 56px;
    }
    .hero-photo {
      order: 0;
      margin-top: 30px;
      justify-self: start;
    }
    .photo-frame {
      width: 100%;
      max-width: 300px;
      height: 340px;
    }
    .lead {
      font-size: 1rem;
    }
    .hero-cta {
      width: 100%;
      gap: 12px;
    }
    .hero-cta .btn {
      flex: 1 1 46%;
    }
    .hero-meta {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px 18px;
      margin-top: 30px;
    }
    .stats-grid {
      gap: 28px 16px;
    }
    .num {
      font-size: 1.7rem;
    }
  }
  @media (max-width: 420px) {
    h1 {
      font-size: 2.5rem;
    }
    .hero-cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
