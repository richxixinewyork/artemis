---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import { projects } from '../content/projects';
import { getPortrait } from '../lib/media';
import { url, emphasize } from '../lib/url';

const portrait = getPortrait('hero');
const { hero } = site;
---

<section class="relative overflow-hidden pt-24 md:pt-32" aria-labelledby="hero-title">
  <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10 pb-16 md:pb-24">
    <div class="col-span-12 flex flex-col justify-between lg:col-span-7">
      <div>
        <p class="eyebrow intro-rise" style="--d:0">{hero.eyebrow}</p>
        <h1 id="hero-title" class="display-xl intro-rise mt-6 md:mt-10" style="--d:1">
          <span class="sr-only">{site.name} — </span><Fragment set:html={emphasize(hero.headline)} />
        </h1>
      </div>

      <div class="mt-10 max-w-xl lg:mt-16">
        <p class="intro-rise text-[1.05rem] leading-relaxed text-ink-soft md:text-lg" style="--d:2">{hero.intro}</p>
        <div class="intro-rise mt-9 flex flex-wrap gap-3" style="--d:3">
          <a href={url('/#work')} class="btn btn-solid">Explore my work <span class="arrow" aria-hidden="true">→</span></a>
          <a href={url('/resume/')} class="btn btn-ghost">View resume</a>
          <a href={url('/#contact')} class="btn btn-ghost">Get in touch</a>
        </div>
      </div>
    </div>

    <figure class="col-span-12 sm:col-span-8 sm:col-start-3 lg:col-span-5 lg:col-start-8">
      <div class="intro-unveil relative aspect-[4/5] overflow-hidden bg-cream">
        {portrait ? (
          <Picture
            src={portrait}
            alt={hero.portraitAlt}
            widths={[480, 768, 1080, 1440]}
            sizes="(min-width: 1024px) 38vw, (min-width: 640px) 66vw, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-[50%_20%]"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-ink-mute">Add src/assets/portraits/hero.jpg</div>
        )}
      </div>
      <figcaption class="intro-rise mt-3 flex justify-between text-xs tracking-[0.12em] text-ink-mute uppercase" style="--d:4">
        <span>{site.name}</span>
        <span>{site.location}</span>
      </figcaption>
    </figure>
  </div>

  <div class="rule">
    <div class="wrap flex flex-col gap-3 py-6 md:flex-row md:items-center md:gap-10">
      <p class="eyebrow shrink-0">Experience across</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 font-display text-xl text-ink md:text-2xl">
        {projects.map((p) => <li><a href={url(`/work/${p.slug}/`)} class="link-draw">{p.org}</a></li>)}
      </ul>
    </div>
  </div>
</section>
