---
import { Picture } from 'astro:assets';
import { projects, type Project } from '../content/projects';
import { getProjectMedia, getLogo } from '../lib/media';
import LogoTile from './LogoTile.astro';

interface Props {
  project: Project;
  sizes: string;
  eager?: boolean;
  /** 'index' for the homepage gallery, 'hero' for the top of a case study. */
  variant?: 'index' | 'hero';
  class?: string;
}

const { project, sizes, eager = false, variant = 'index', class: className = '' } = Astro.props;
const { cover } = getProjectMedia(project);
const hasLogo = Boolean(getLogo(project.slug));
const dark = project.tone === 'ink';
const n = projects.indexOf(project) + 1;
const pad = (x: number) => String(x).padStart(2, '0');
---

<div class:list={['cover relative overflow-hidden', className]} style={`--tone: var(--color-tone-${project.tone})`}>
  {cover ? (
    <Picture
      src={cover.src}
      alt={cover.alt}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      class="cover-media h-full w-full object-cover"
    />
  ) : (
    /*
     * Typographic placard — a deliberate, labeled placeholder until real,
     * authorized project imagery is added to src/assets/projects/<slug>/cover.jpg
     */
    <div class:list={['cover-media plate grain h-full w-full', dark ? 'text-ivory' : 'text-ink']}>
      <div class="plate-frame absolute inset-3 md:inset-4" aria-hidden="true"></div>
      <div class="relative z-[2] flex h-full flex-col justify-between p-6 md:p-9">
        <span class="flex items-start justify-between gap-4 text-[0.66rem] tracking-[0.22em] uppercase opacity-75" aria-hidden="true">
          <span>{project.discipline}</span>
          <span class="hidden tabular-nums sm:inline">{pad(n)} / {pad(projects.length)}</span>
        </span>

        <span class="flex flex-1 items-center justify-center py-6" aria-hidden="true" data-logo-wrap>
          {hasLogo && (
            <LogoTile slug={project.slug} name={project.org} size={variant === 'hero' ? 'lg' : 'md'} background={project.logoBackground} />
          )}
          {/* Initial shown when there is no logo, or if the logo image fails to load */}
          <span class:list={['monogram font-display italic', variant === 'hero' && 'monogram-lg', hasLogo && 'monogram-fallback']}>{project.org.charAt(0)}</span>
        </span>

        <span class="flex items-end justify-end gap-4 text-[0.66rem] sm:justify-between tracking-[0.22em] uppercase">
          <span class="hidden opacity-75 sm:inline" aria-hidden="true">{project.period}</span>
          <span class="flex items-center gap-2 opacity-75">
            <span class="inline-block size-2 border border-current" aria-hidden="true"></span>
            <span><span class="hidden sm:inline">Project </span>imagery forthcoming</span>
          </span>
        </span>
      </div>
    </div>
  )}
</div>

<style>
  .cover {
    background: var(--tone);
  }
  .cover-media {
    transition: transform 1.4s var(--ease-editorial);
  }
  .plate {
    position: relative;
    background:
      radial-gradient(110% 80% at 80% 0%, color-mix(in srgb, white 20%, transparent), transparent 60%),
      radial-gradient(90% 70% at 10% 100%, color-mix(in srgb, black 8%, transparent), transparent 70%),
      var(--tone);
  }
  .plate-frame {
    border: 1px solid currentColor;
    opacity: 0.18;
  }
  .monogram {
    display: grid;
    place-items: center;
    width: clamp(6rem, 14vw, 9rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 999px;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    line-height: 1;
    padding-bottom: 0.08em;
  }
  .monogram-fallback {
    display: none;
  }
  [data-logo-failed] .monogram-fallback {
    display: grid;
  }
  [data-logo-failed] :global([data-logo]) {
    display: none;
  }
  .monogram-lg {
    width: clamp(8rem, 18vw, 13rem);
    font-size: clamp(4.5rem, 10vw, 8rem);
  }
</style>
