---
/**
 * Click-to-load YouTube player. Nothing is requested from YouTube until the
 * visitor presses play; the player then loads from youtube-nocookie.com.
 * No thumbnail is fetched or rehosted — the frame is a plain placeholder.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
}

const { id, title, caption } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="yt">
  <div class="frame" data-yt={id} data-yt-title={title}>
    <button type="button" class="play" aria-label={`Play video: ${title}`}>
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
      </span>
      <span class="t">{title}</span>
      <span class="n">Plays from YouTube when you press play</span>
    </button>
  </div>
  <figcaption>
    {caption}
    <a href={watchUrl} target="_blank" rel="noopener noreferrer" class="arrow-link">Watch on YouTube <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
  </figcaption>
</figure>

<style>
  .yt {
    max-width: 760px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
    background: var(--dark-bg);
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: #fff;
    cursor: pointer;
  }
  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    transition: transform 0.2s;
  }
  .play:hover .icon {
    transform: scale(1.08);
  }
  .t {
    max-width: 32ch;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .n {
    font-size: 0.78rem;
    color: var(--color-on-dark-mute);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 18px;
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--color-ink-mute);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.ytTitle ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
