---
import { site } from '../content/site';
import { url } from '../lib/url';

interface Props {
  /** Start with the dark bar (pages without a dark hero, e.g. the résumé). */
  solid?: boolean;
}

const { solid = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { label: 'Experience', href: url('/#experience') },
  { label: 'Expertise', href: url('/#expertise') },
  { label: 'About', href: url('/#about') },
  { label: 'Work', href: url('/#work') },
  { label: 'Case Studies', href: url('/case-studies/'), current: path.endsWith('/case-studies') },
  { label: 'Contact', href: url('/#contact') },
];
const resumeHref = url('/resume/');
const onResume = path.endsWith('/resume');
---

<header role="banner" class:list={['nav', { 'is-solid': solid }]} data-header>
  <div class="shell nav-inner">
    <a href={url('/')} class="brand" aria-label={`${site.name} — home`}>
      <span class="dot" aria-hidden="true"></span>{site.name}<small>Growth &amp; Partnerships</small>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links" id="nav-links" data-menu>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.current ? 'page' : undefined} data-menu-link>{l.label}</a></li>
        ))}
        <li>
          <a href={resumeHref} class="btn btn-primary btn-sm" aria-current={onResume ? 'page' : undefined} data-menu-link>Resume</a>
        </li>
        {site.resume.pdf && (
          <li class="drawer-only">
            <a href={url(site.resume.pdf)} download type="application/pdf" data-menu-link>Download resume (PDF) ↓</a>
          </li>
        )}
      </ul>
    </nav>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-links" data-menu-toggle>
      <span class="sr-only" data-menu-label>Open menu</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 22px 0;
    transition: padding 0.3s;
  }
  /* The bar's backdrop lives on a pseudo-element: backdrop-filter on .nav itself
     would trap the fixed mobile drawer inside the bar. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(20 18 16 / 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 6px 30px -12px rgb(0 0 0 / 0.5);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .nav[data-scrolled]::before,
  .nav.is-solid::before {
    opacity: 1;
  }
  .nav[data-scrolled],
  .nav.is-solid {
    padding: 14px 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }
  .brand .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent-light);
  }
  .brand small {
    margin-left: 4px;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-dark-mute);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav-links a:not(.btn) {
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    color: #e9e6e1;
    transition: color 0.2s;
  }
  .nav-links a:not(.btn):hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-accent-light);
  }
  .drawer-only {
    display: none;
  }
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 101;
  }
  .menu-icon {
    position: relative;
    width: 22px;
    height: 14px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s, opacity 0.3s;
  }
  .menu-icon span:nth-child(1) { top: 0; }
  .menu-icon span:nth-child(2) { top: 6px; }
  .menu-icon span:nth-child(3) { top: 12px; }
  [aria-expanded='true'] .menu-icon span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .menu-icon span:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .menu-icon span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1199px) {
    .brand small {
      display: none;
    }
    .nav-links {
      gap: 24px;
    }
  }
  /* Seven links need more room than the reference's six, so the drawer starts below 1024px */
  @media (max-width: 1023px) {
    .nav-toggle {
      display: flex;
    }
    .nav-links {
      position: fixed;
      inset: 0 0 0 auto;
      width: 82%;
      max-width: 320px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 24px;
      padding: 40px;
      background: var(--color-ink);
      box-shadow: -20px 0 40px -20px rgb(0 0 0 / 0.6);
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.3s, visibility 0.3s;
    }
    .nav-links.open {
      transform: none;
      visibility: visible;
    }
    .nav-links a:not(.btn) {
      font-size: 1.15rem;
    }
    .drawer-only {
      display: block;
    }
    .drawer-only a:not(.btn) {
      font-size: 0.9rem;
      color: var(--color-on-dark);
    }
  }
  @media (max-width: 680px) {
    .nav {
      padding: 16px 0;
    }
    .nav[data-scrolled],
    .nav.is-solid {
      padding: 12px 0;
    }
    .brand small {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = document.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close menu' : 'Open menu';
    menu.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
