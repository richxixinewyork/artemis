---
import { Picture } from 'astro:assets';
import ProjectVideo from './ProjectVideo.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';
import { type Project, statusLabel } from '../content/projects';
import { getProjectMedia } from '../lib/media';
import { url } from '../lib/url';

/**
 * One case study: context → what she owned → approach → results, with a sticky
 * "Results & impact" panel and any real media. Used on /case-studies/ (all five,
 * with headings) and on each /work/<slug>/ page (standalone, under its own hero).
 */
interface Props {
  project: Project;
  index: number;
  standalone?: boolean;
  alt?: boolean;
}

const { project: p, index, standalone = false, alt = false } = Astro.props;
const { cover, gallery } = getProjectMedia(p);
const n = String(index + 1).padStart(2, '0');
const id = `cs-${p.slug}`;
const hasMedia = Boolean(cover || gallery.length || p.video);
const h = {
  context: p.headings?.context ?? 'The Context',
  owned: p.headings?.owned ?? 'What She Owned',
  approach: p.headings?.approach ?? 'Her Approach',
  status: p.headings?.status ?? 'Where It Stands',
};
---

<section class:list={['cs-section', { 'is-alt': alt }]} id={standalone ? undefined : p.slug} aria-labelledby={id}>
  <div class="shell">
    {standalone ? (
      <h2 id={id} class="sr-only">{p.org} case study</h2>
    ) : (
      <header class="cs-head" data-reveal>
        <p class="cs-num">Case Study {n}</p>
        <h2 id={id}>{p.org} <span>— {p.title}</span></h2>
        <p class="sub">{p.summary}</p>
        <p class="facts">{p.role} · {p.period}{p.location && ` · ${p.location}`}{p.products && ` · ${p.products}`}</p>
      </header>
    )}

    <div class="cs-cols">
      <div data-reveal>
        <div class="cs-block">
          <h3>{h.context}</h3>
          {p.challenge.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
          {p.context && <p class="note">{p.context}</p>}
        </div>
        {p.owned.length > 0 && (
          <div class="cs-block">
            <h3>{h.owned}</h3>
            {p.ownedAsText ? p.owned.map((o) => <p>{o}</p>) : <ul class="dots">{p.owned.map((o) => <li>{o}</li>)}</ul>}
          </div>
        )}
        <div class="cs-block">
          <h3>{h.approach}</h3>
          {p.contributions.map((c) => (
            <div class="step">
              <h4>{c.heading}</h4>
              <p>{c.body}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="cs-results" data-reveal style="--d:1" aria-label={`${p.org} results`}>
        {p.results.length > 0 ? (
          <>
            <h4>Results &amp; Impact</h4>
            {p.results.map((r) => (
              <div class="r">
                <div class="big">{r.value}</div>
                <div class="lbl">{r.label}</div>
                {r.note && <div class="nt">{r.note}</div>}
              </div>
            ))}
            <p class="src">Figures as reported in Artemis’s résumé.</p>
          </>
        ) : p.focus ? (
          <>
            <h4>{h.status}</h4>
            {p.focus.map((f) => <div class="r"><div class="lbl">{f}</div></div>)}
          </>
        ) : (
          <>
            <h4>{h.status}</h4>
            <div class="r"><div class="big">{statusLabel[p.status]}</div></div>
            {p.statusNote?.map((t) => <p class="note-dark">{t}</p>)}
          </>
        )}
        {!standalone && <a href={url(`/work/${p.slug}/`)} class="btn btn-primary">Project page <span aria-hidden="true">→</span></a>}
      </aside>
    </div>

    {hasMedia && (
      <div class="cs-media" data-reveal>
        <h3 class="media-h">Selected Media</h3>
        {p.video && <YouTubeEmbed id={p.video.youtubeId} title={p.video.title} caption={p.video.caption} />}
        {(cover || gallery.length > 0) && (
          <div class="cs-gallery">
            {cover && (
              <figure class="wide">
                <Picture src={cover.src} alt={cover.alt} widths={[600, 1100, 1600]} sizes="(min-width: 1140px) 1092px, 100vw" formats={['avif', 'webp']} />
              </figure>
            )}
            {gallery.map((g) => (
              <figure>
                {g.type === 'video' ? (
                  <ProjectVideo src={g.src} poster={g.poster} alt={g.alt} />
                ) : (
                  <Picture src={g.src} alt={g.alt} widths={[400, 700]} sizes="(min-width: 920px) 260px, 50vw" formats={['avif', 'webp']} />
                )}
              </figure>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .cs-section {
    padding: 72px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .cs-section.is-alt {
    background: var(--color-cream);
  }
  .cs-head {
    margin-bottom: 34px;
  }
  .cs-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .cs-head h2 {
    margin: 6px 0 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
  }
  .cs-head h2 span {
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .sub {
    max-width: 680px;
    font-size: 1.02rem;
    color: var(--color-ink-mute);
  }
  .facts {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  .cs-cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .cs-block + .cs-block {
    margin-top: 28px;
  }
  .cs-block h3,
  .media-h {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 10px;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cs-block h3::before,
  .media-h::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .cs-block p {
    color: #3a3632;
  }
  .cs-block p + p {
    margin-top: 10px;
  }
  .cs-block .note {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--color-ink-mute);
  }
  .dots {
    margin: 6px 0 0 20px;
    list-style: disc;
    color: #3a3632;
  }
  .dots li {
    margin-bottom: 6px;
  }
  .dots li::marker {
    color: var(--color-accent);
  }
  .step + .step {
    margin-top: 16px;
  }
  .step h4 {
    font-size: 1rem;
    font-weight: 600;
  }
  .step p {
    margin-top: 2px;
  }

  .cs-results {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    padding: 30px;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: #fff;
  }
  .cs-results h4 {
    margin-bottom: 8px;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }
  .r {
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .big {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-accent-light);
  }
  .lbl {
    margin-top: 3px;
    font-size: 0.9rem;
    color: #e4dfd7;
  }
  .nt {
    margin-top: 2px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-on-dark-mute);
  }
  .note-dark {
    margin-top: 12px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-on-dark);
  }
  .src {
    margin-top: 14px;
    font-size: 0.75rem;
    color: var(--color-on-dark-mute);
  }
  .cs-results .btn {
    margin-top: 18px;
  }

  .cs-media {
    margin-top: 48px;
  }
  .media-h {
    margin-bottom: 18px;
  }
  .cs-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    align-items: start;
  }
  .cs-gallery figure {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: #fff;
  }
  .cs-gallery .wide {
    grid-column: 1 / -1;
  }
  /* A lone gallery image (no cover) stays at a showcase size rather than spanning the page */
  .cs-gallery figure:only-child:not(.wide) {
    grid-column: 1 / -1;
    max-width: 520px;
  }
  .cs-gallery :global(img),
  .cs-gallery :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cs-media :global(.yt) + .cs-gallery {
    margin-top: 24px;
  }
  @media (max-width: 920px) {
    .cs-cols {
      grid-template-columns: 1fr;
    }
    .cs-results {
      position: static;
    }
  }
  @media (max-width: 680px) {
    .cs-section {
      padding: 56px 0;
    }
    .cs-results {
      padding: 24px 22px;
    }
    .cs-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
