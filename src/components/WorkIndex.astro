---
import ProjectCover from './ProjectCover.astro';
import StatusTag from './StatusTag.astro';
import { projects } from '../content/projects';
import { url } from '../lib/url';

// Asymmetric editorial layout — one entry per project, cycling if more are added.
const layouts = [
  { media: 'lg:col-span-7 aspect-[4/3]', text: 'lg:col-span-4 lg:col-start-9 lg:self-end', sizes: '(min-width: 1024px) 56vw, 100vw' },
  { media: 'lg:col-span-6 lg:col-start-7 lg:row-start-1 aspect-[4/3] lg:aspect-[4/5]', text: 'lg:col-span-4 lg:col-start-2 lg:row-start-1 lg:self-center', sizes: '(min-width: 1024px) 48vw, 100vw' },
  { media: 'lg:col-span-5 lg:col-start-1 aspect-[4/3] lg:aspect-[3/4]', text: 'lg:col-span-5 lg:col-start-7 lg:self-start lg:pt-24', sizes: '(min-width: 1024px) 40vw, 100vw' },
  { media: 'lg:col-span-6 lg:col-start-6 aspect-[4/3] lg:aspect-[5/4]', text: 'lg:col-span-4 lg:col-start-1 lg:row-start-1 lg:self-end', sizes: '(min-width: 1024px) 48vw, 100vw' },
  { media: 'lg:col-span-12 aspect-[4/3] lg:aspect-[21/9]', text: 'lg:col-span-6 lg:col-start-7', sizes: '100vw' },
];
---

<section id="work" class="py-24 md:py-40" aria-labelledby="work-title">
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6" data-reveal>
      <p class="eyebrow col-span-12 md:col-span-3">Selected work <span class="text-ink-mute">({String(projects.length).padStart(2, '0')})</span></p>
      <h2 id="work-title" class="display-lg col-span-12 md:col-span-9">
        Five chapters across consumer tech, fashion, beauty <em>&amp; culture</em>.
      </h2>
    </div>

    <ol class="mt-20 space-y-24 md:mt-32 md:space-y-40">
      {projects.map((p, i) => {
        const l = layouts[i % layouts.length];
        const n = String(i + 1).padStart(2, '0');
        return (
          <li>
            <a href={url(`/work/${p.slug}/`)} class="work-item group grid grid-cols-12 gap-x-6 gap-y-8 lg:gap-y-0">
              <div class:list={['col-span-12', l.media]} data-reveal>
                <ProjectCover project={p} sizes={l.sizes} class="h-full w-full" />
              </div>
              <div class:list={['col-span-12 md:max-w-2xl lg:max-w-none', l.text]} data-reveal style="--d:1">
                <div class="flex items-center justify-between gap-4">
                  <span class="font-display text-2xl text-accent tabular-nums">{n}</span>
                  <StatusTag status={p.status} />
                </div>
                <h3 class="mt-5 font-display text-[clamp(2.6rem,4.4vw,3.6rem)] leading-[0.95]">{p.org}</h3>
                <p class="mt-3 font-display text-xl leading-snug text-ink-soft italic">{p.title}</p>
                <p class="mt-5 leading-relaxed text-ink-soft">{p.summary}</p>

                <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-5 text-sm">
                  <div class="col-span-2 sm:col-span-1"><dt class="eyebrow">Role</dt><dd class="mt-1 text-ink">{p.role}</dd></div>
                  <div class="col-span-2 sm:col-span-1"><dt class="eyebrow">Timeframe</dt><dd class="mt-1 text-ink tabular-nums">{p.period}</dd></div>
                  <div class="col-span-2"><dt class="eyebrow">Category</dt><dd class="mt-1 text-ink">{p.discipline}</dd></div>
                </dl>

                {p.results[0] && (
                  <p class="mt-6 flex items-baseline gap-4 border-t border-line pt-5">
                    <span class="font-display text-[2.6rem] leading-none whitespace-nowrap">{p.results[0].value}</span>
                    <span class="text-sm leading-snug text-ink-soft">
                      {p.results[0].label}{p.results[0].note && <span class="block text-ink-mute">{p.results[0].note}</span>}
                    </span>
                  </p>
                )}

                <span class="mt-7 inline-flex min-h-11 items-center gap-2 text-[0.78rem] tracking-[0.14em] uppercase">
                  <span class="link-draw">View case study</span>
                  <span class="transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .work-item:hover :global(.cover-media) {
    transform: scale(1.035);
  }
  .work-item:hover h3 {
    color: var(--color-accent);
  }
  .work-item h3 {
    transition: color 0.5s var(--ease-editorial);
  }
  .work-item:hover .link-draw {
    background-size: 100% 1px;
  }
</style>
