---
import { impact } from '../content/site';
---

<section id="impact" class="bg-ink py-24 text-ivory md:py-36" aria-labelledby="impact-title">
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6" data-reveal>
      <p class="eyebrow col-span-12 !text-ivory/60 md:col-span-3">Impact</p>
      <h2 id="impact-title" class="display-lg col-span-12 md:col-span-9">
        Growth measured in communities, <em class="!text-[#e3a08f]">not just numbers</em>.
      </h2>
    </div>

    <dl class="mt-16 grid grid-cols-1 gap-x-10 sm:grid-cols-2 md:mt-24 lg:grid-cols-3">
      {impact.map((m, i) => (
        <div class="flex flex-col border-t border-ivory/20 pt-8 pb-12" data-reveal style={`--d:${i % 3}`}>
          <dt class="order-2 mt-4 text-lg leading-snug text-ivory">{m.label}</dt>
          <dd class="order-1 font-display text-6xl leading-none tracking-tight md:text-7xl">{m.value}</dd>
          <dd class="order-3 mt-3 text-sm leading-relaxed text-ivory/60">{m.source}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-10 max-w-2xl text-sm leading-relaxed text-ivory/60" data-reveal>
      All figures are taken from Artemis’s résumé. Platform metrics at Momo and Tantan are team outcomes that her work
      contributed to; Missingcity figures reflect the business she founded and runs.
    </p>
  </div>
</section>
