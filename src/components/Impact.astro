---
import { impact } from '../content/site';
---

<section id="impact" class="bg-ink py-24 text-ivory md:py-36" aria-labelledby="impact-title">
  <div class="wrap grid grid-cols-12 gap-x-6 gap-y-14">
    <!-- Heading column stays in view while the figures scroll past -->
    <div class="col-span-12 lg:col-span-4">
      <div class="lg:sticky lg:top-32" data-reveal>
        <p class="eyebrow !text-ivory/60">Impact</p>
        <h2 id="impact-title" class="display-lg mt-6 !text-[clamp(2.5rem,4.2vw,4.2rem)]">
          Growth measured in communities, <em class="!text-[#e3a08f]">not just numbers</em>.
        </h2>
        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ivory/60">
          All figures come from Artemis’s résumé. Platform metrics at Momo and Tantan are team outcomes her work
          contributed to; Missingcity figures reflect the business she founded and runs.
        </p>
      </div>
    </div>

    <ol class="col-span-12 lg:col-span-7 lg:col-start-6">
      {impact.map((m, i) => (
        <li class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-6 border-t border-ivory/15 py-8 last:border-b md:grid-cols-[2.5rem_minmax(0,0.9fr)_minmax(0,1fr)] md:gap-x-8 md:py-10" data-reveal>
          <span class="hidden text-xs text-ivory/50 tabular-nums md:block">{String(i + 1).padStart(2, '0')}</span>
          <span class="col-span-2 font-display text-[clamp(3.2rem,6vw,5rem)] leading-[0.9] tracking-tight whitespace-nowrap md:col-span-1">{m.value}</span>
          <span class="col-span-2 mt-3 md:col-span-1 md:mt-0">
            <span class="block text-lg leading-snug">{m.label}</span>
            <span class="mt-2 block text-sm leading-relaxed text-ivory/55">{m.source}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

