---
import { site } from '../content/site';
import { emphasize } from '../lib/url';

const { about, education } = site;
const study = [education.degree, education.field].filter(Boolean).join(', ');
const facts = [
  { k: 'Based in', v: site.location },
  { k: 'Studying', v: `${study} · ${education.period}` },
  { k: 'Languages', v: about.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ') },
  { k: 'Platforms', v: about.platforms.join(', ') },
  { k: 'Tools', v: about.tools.join(', ') },
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="shell about-grid">
    <div class="about-body" data-reveal>
      <p class="eyebrow">About Me</p>
      <h2 id="about-title" set:html={emphasize(about.heading)} />
      <p class="lead">{about.lead}</p>
      {about.chapters.map((c) => (
        <div class="chapter">
          <h3>{c.label}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>

    <aside class="about-card panel" data-reveal style="--d:1" aria-labelledby="facts-title">
      <h3 id="facts-title">Quick Facts</h3>
      <dl>
        {facts.map((f) => (
          <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
      <h3 class="mt">Coursework</h3>
      <ul class="ticks">{education.coursework.map((c) => <li>{c}</li>)}</ul>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.62fr 1fr;
    gap: 56px;
    align-items: start;
  }
  h2 {
    font-size: 2.6rem;
  }
  h2 :global(em) {
    font-style: normal;
    color: var(--color-accent);
  }
  .lead {
    margin-top: 22px;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .chapter {
    margin-top: 26px;
  }
  .chapter h3 {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .chapter p {
    margin-top: 6px;
    font-size: 1.05rem;
    color: #3a3632;
  }
  .about-card {
    position: sticky;
    top: 96px;
    padding: 30px;
    box-shadow: var(--shadow);
  }
  .about-card h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }
  .about-card h3.mt {
    margin-top: 22px;
  }
  .fact {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.95rem;
  }
  .fact dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-accent);
  }
  .fact dd {
    color: #33302c;
  }
  @media (max-width: 920px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-card {
      position: static;
    }
  }
  @media (max-width: 680px) {
    h2 {
      font-size: 2rem;
    }
    .about-card {
      padding: 24px 22px;
    }
  }
</style>
