---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
import { projects, statusLabel } from '../content/projects';
import { url } from '../lib/url';

const { resume, education, about, contact, otherExperience } = site;
const corporate = projects.filter((p) => p.status === 'completed');
const ventures = projects.filter((p) => p.status !== 'completed');
const degree = [education.degree, education.field].filter(Boolean).join(' in ');
const competencies = about.capabilities.flatMap((c) => c.items);

const groups = [
  { title: 'Professional experience', items: corporate },
  { title: 'Entrepreneurial & brand experience', items: ventures },
];
---

<Base title="Resume" description={`Resume of ${site.name}: ${resume.headline}.`}>
  <div class="wrap pt-28 pb-24 md:pt-40 md:pb-36">
    <header class="grid grid-cols-12 items-end gap-x-6 gap-y-8 border-b border-ink pb-10">
      <div class="col-span-12 md:col-span-8">
        <p class="eyebrow intro-rise">Resume</p>
        <h1 class="display-xl intro-rise mt-6" style="--d:1">{site.name}</h1>
        <p class="intro-rise mt-5 text-lg text-ink-soft" style="--d:2">{resume.headline}</p>
      </div>
      <div class="no-print intro-rise col-span-12 flex flex-wrap gap-3 md:col-span-4 md:justify-end" style="--d:3">
        {resume.pdf && <a href={url(resume.pdf)} class="btn btn-solid" download type="application/pdf">Download resume <span class="arrow" aria-hidden="true">↓</span></a>}
        <button type="button" class="btn btn-ghost" data-print>Print</button>
      </div>
    </header>

    <div class="grid grid-cols-12 gap-x-6">
      <aside class="col-span-12 border-b border-line py-8 md:col-span-3 md:border-b-0 md:py-12 md:pr-6">
        <dl class="space-y-6 text-sm">
          <div><dt class="eyebrow">Based in</dt><dd class="mt-1">{site.location}</dd></div>
          {contact.email && <div><dt class="eyebrow">Email</dt><dd class="mt-1"><a class="link-draw" href={`mailto:${contact.email}`}>{contact.email.split('@')[0]}<wbr />@{contact.email.split('@')[1]}</a></dd></div>}
          <div>
            <dt class="eyebrow">Languages</dt>
            {about.languages.map((l) => <dd class="mt-1">{l.name} <span class="text-ink-mute">— {l.level}</span></dd>)}
          </div>
          <div>
            <dt class="eyebrow">Platforms</dt>
            <dd class="mt-1">{about.platforms.join(', ')}</dd>
          </div>
          <div>
            <dt class="eyebrow">Tools</dt>
            <dd class="mt-1">{about.tools.join(', ')}</dd>
          </div>
        </dl>
      </aside>

      <div class="col-span-12 md:col-span-9 md:border-l md:border-line md:pl-10">
        <section class="border-b border-line py-10 md:py-12" aria-labelledby="r-summary">
          <h2 id="r-summary" class="eyebrow">Summary</h2>
          <p class="mt-4 max-w-3xl font-display text-2xl leading-snug md:text-[1.75rem]">{resume.summary}</p>
        </section>

        {groups.map((g) => (
          <section class="border-b border-line py-10 md:py-12" aria-label={g.title}>
            <h2 class="eyebrow">{g.title}</h2>
            <div class="mt-6 space-y-10">
              {g.items.map((p) => (
                <article>
                  <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
                    <h3 class="font-display text-3xl leading-tight">
                      <a href={url(`/work/${p.slug}/`)} class="link-draw">{p.org}</a>
                    </h3>
                    <p class="text-sm text-ink-mute tabular-nums">{p.period}{p.location && ` · ${p.location}`}</p>
                  </div>
                  <p class="mt-1 text-ink-soft">
                    {p.role}
                    {p.status === 'in-development' && <span class="ml-2 text-sm text-accent">({statusLabel[p.status]})</span>}
                  </p>
                  <ul class="mt-4 space-y-2 leading-relaxed">
                    {p.highlights.map((h) => (
                      <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent">{h}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        ))}

        <section class="border-b border-line py-10 md:py-12" aria-labelledby="r-other">
          <h2 id="r-other" class="eyebrow">Other experience</h2>
          <div class="mt-6 space-y-10">
            {otherExperience.map((o) => (
              <article>
                <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
                  <h3 class="font-display text-3xl leading-tight">{o.org}</h3>
                  <p class="shrink-0 text-sm text-ink-mute tabular-nums">{o.period} · {o.location}</p>
                </div>
                <p class="mt-1 text-ink-soft">{o.role}</p>
                <ul class="mt-4 space-y-2 leading-relaxed">
                  {o.highlights.map((h) => (
                    <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent">{h}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="border-b border-line py-10 md:py-12" aria-labelledby="r-edu">
          <h2 id="r-edu" class="eyebrow">Education</h2>
          <div class="mt-6 flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
            <h3 class="font-display text-3xl leading-tight">{degree}</h3>
            <p class="text-sm text-ink-mute tabular-nums">{education.period} · {education.location}</p>
          </div>
          {education.school && <p class="mt-1 text-ink-soft">{education.school}</p>}
          <p class="mt-3 text-sm text-ink-mute">Coursework: {education.coursework.join('; ')}.</p>
        </section>

        <section class="py-10 md:py-12" aria-labelledby="r-comp">
          <h2 id="r-comp" class="eyebrow">Core competencies</h2>
          <ul class="mt-5 flex flex-wrap gap-2">
            {competencies.map((c) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft">{c}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
