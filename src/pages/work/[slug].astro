---
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import ProjectThumb from '../../components/ProjectThumb.astro';
import Contact from '../../components/Contact.astro';
import { projects, statusLabel, type Project } from '../../content/projects';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i },
  }));
}

interface Props {
  project: Project;
  index: number;
}

const { project: p, index } = Astro.props;
const total = projects.length;
const prev = projects[(index - 1 + total) % total];
const next = projects[(index + 1) % total];
const pad = (x: number) => String(x).padStart(2, '0');

const facts = [
  { k: 'Role', v: p.role },
  ...(p.products ? [{ k: 'Products', v: p.products }] : []),
  { k: 'Timeframe', v: p.period },
  ...(p.location ? [{ k: 'Location', v: p.location }] : []),
  { k: 'Status', v: statusLabel[p.status] },
];
---

<Base title={`${p.org} — ${p.title}`} description={p.summary}>
  <header class="article-hero on-dark">
    <div class="shell hero-grid">
      <div>
        <nav aria-label="Breadcrumb" class="crumbs intro-rise" style="--d:0">
          <a href={url('/case-studies/')}>Case Studies</a><span aria-hidden="true">/</span><span aria-current="page">{pad(index + 1)} of {pad(total)}</span>
        </nav>
        <p class="eyebrow intro-rise" style="--d:1">Case Study {pad(index + 1)} · {p.discipline}</p>
        <h1 class="intro-rise" style="--d:1">{p.org}</h1>
        <p class="title intro-rise" style="--d:2">{p.title}</p>
        <p class="pmeta intro-rise" style="--d:3">{p.summary}</p>
        <dl class="facts intro-rise" style="--d:4">
          {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
      <div class="hero-thumb intro-rise" style="--d:2">
        <ProjectThumb project={p} sizes="(min-width: 920px) 420px, 100vw" />
      </div>
    </div>
  </header>

  <CaseStudy project={p} index={index} standalone />

  <nav class="pager" aria-label="More case studies">
    <div class="shell pager-grid">
      <a href={url(`/work/${prev.slug}/`)} class="panel lift">
        <span class="k">← Previous</span><span class="o">{prev.org}</span><span class="t">{prev.title}</span>
      </a>
      <a href={url(`/work/${next.slug}/`)} class="panel lift right">
        <span class="k">Next →</span><span class="o">{next.org}</span><span class="t">{next.title}</span>
      </a>
    </div>
  </nav>

  <Contact />
</Base>

<style>
  .article-hero {
    padding: 140px 0 70px;
    background: var(--dark-bg);
    color: #fff;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 50px;
    align-items: center;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
    font-size: 0.82rem;
    color: var(--color-on-dark-mute);
  }
  .crumbs a {
    color: var(--color-on-dark);
  }
  .crumbs a:hover {
    color: var(--color-accent-light);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: #fff;
  }
  .title {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: #e4dfd7;
  }
  .pmeta {
    max-width: 600px;
    margin-top: 14px;
    color: var(--color-on-dark);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 18px 24px;
    margin-top: 28px;
  }
  .facts dt {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-light);
  }
  .facts dd {
    margin-top: 2px;
    font-size: 0.92rem;
    color: #e4dfd7;
  }
  .hero-thumb {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.8);
  }
  .pager {
    padding: 56px 0;
  }
  .pager-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px 26px;
  }
  .pager .right {
    align-items: flex-end;
    text-align: right;
  }
  .k {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .o {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .t {
    font-size: 0.9rem;
    color: var(--color-ink-mute);
  }
  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-thumb {
      max-width: 520px;
    }
  }
  @media (max-width: 680px) {
    .article-hero {
      padding: 110px 0 52px;
    }
    .pager-grid {
      grid-template-columns: 1fr;
    }
    .pager .right {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
